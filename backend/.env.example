# Copie para backend/.env (fora do git) e preencha a chave.
# Sem chave, o copiloto roda offline: entende só "AER-99 atrasou 2 semanas" e "AER-99 falhou".

# Model Gateway (LiteLLM) apontando para o OpenRouter, modelo free
LLM_MODEL=openrouter/google/gemma-4-31b-it:free
LLM_FALLBACKS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# Para trocar para a Anthropic, é só isto (nenhuma linha de código muda):
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_FALLBACKS=
# ANTHROPIC_API_KEY=

# Dados (ticket 05b): json (padrão, o mock) ou supabase
DATA_BACKEND=json
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Chave secreta (sb_secret_...): Project Settings > API Keys. Só no backend, nunca no navegador
SUPABASE_SECRET_KEY=
